package main

import (
	"context"
	"embed"
	"fmt"
	"os"
	"runtime"

	"github.com/wailsapp/wails/v2"
	"github.com/wailsapp/wails/v2/pkg/menu"
	"github.com/wailsapp/wails/v2/pkg/options"
	"github.com/wailsapp/wails/v2/pkg/options/assetserver"
	"github.com/wailsapp/wails/v2/pkg/options/mac"
)

const appName = @@APP_NAME@@
const appID = @@APP_ID@@

//go:embed runtime.tar.gz
var embeddedRuntime embed.FS

func main() {
	server := newLocalServer()
	appMenu := menu.NewMenu()
	if runtime.GOOS == "darwin" {
		appMenu.Append(menu.AppMenu())
		appMenu.Append(menu.EditMenu())
	}
	err := wails.Run(&options.App{
		Title: appName, Width: 1280, Height: 800, MinWidth: 800, MinHeight: 560,
		Menu: appMenu,
		AssetServer: &assetserver.Options{Handler: server, Middleware: runtimeMiddleware},
		OnStartup: func(ctx context.Context) { server.Start(ctx) },
		OnShutdown: func(context.Context) { server.Stop() },
		DragAndDrop: &options.DragAndDrop{DisableWebViewDrop: true},
		Mac: &mac.Options{TitleBar: mac.TitleBarDefault()},
		SingleInstanceLock: &options.SingleInstanceLock{UniqueId: appID},
	})
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}
